datasource db {
  provider = "sqlite"
}

generator kysely {
  provider = "prisma-kysely"

  output   = "../src/api/db/generated"
  fileName = "types.ts"
}

generator prismark {
  provider = "prismark"

  output   = "../src/api/db/generated"
  fileName = "schemas.ts"
}

model users {
  id       Int    @id @default(autoincrement())
  name     String
  password String
}
