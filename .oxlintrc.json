{
	"extends": ["./node_modules/@lobomfz/check/.oxlintrc.json"],
	"rules": {
		"lobomfz/no-trivial-call-wrapper": "off"
	},
	"overrides": [
		{
			"files": ["src/api/**"],
			"rules": {
				"lobomfz/no-trivial-call-wrapper": "error"
			}
		},
		{
			"files": ["tests/**/*.test.ts", "tests/**/*.test.tsx"],
			"rules": {
				"require-await": "off",
				"typescript/require-await": "off",
				"max-classes-per-file": "off"
			}
		}
	],
	"options": {
		"typeAware": true
	}
}
